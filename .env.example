# ── Authentification (mode web) ───────────────────────────────────
# AUTH_SECRET : clé HMAC de signature des JWT (min 16 caractères).
# Si ABSENTE, l'authentification est DÉSACTIVÉE (mode local uniquement).
# En production (NODE_ENV=production), le serveur REFUSE de démarrer
# sans AUTH_SECRET (fail-closed).
AUTH_SECRET="CHANGE_ME_32_chars_minimum"

# Tokens statiques échangés contre un JWT au login (rôles distincts).
# Un token absent = aucun compte pour ce rôle.
ADMIN_TOKEN="CHANGE_ME_admin"
DEV_TOKEN="CHANGE_ME_dev"
GUEST_TOKEN="CHANGE_ME_guest"

# ── Serveur ───────────────────────────────────────────────────────
# Port HTTP (défaut : 3000, cohérent avec Vite dev et Playwright).
PORT=3000

# ── WebSocket ─────────────────────────────────────────────────────
# Liste blanche des Origins autorisées (anti-CSWSH), séparées par des
# virgules. Défaut : localhost:3000 + webview Tauri.
# WS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Webview Tauri ─────────────────────────────────────────────────
# L'app desktop (Tauri) ne requiert PAS de serveur HTTP : le PTY vit
# dans le processus Rust. Ces variables ne concernent que le mode web.
