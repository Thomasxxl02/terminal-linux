# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Authentification ──────────────────────────────────────────────
# AUTH_SECRET : clé HMAC de signature des JWT (min 16 caractères).
# Si ABSENTE, l'authentification est DÉSACTIVÉE (comportement hérité,
# non recommandé hors développement local).
AUTH_SECRET="CHANGE_ME_32_chars_minimum"

# Tokens statiques échangés contre un JWT via POST /api/auth/login.
# Chaque token donne un rôle avec des permissions différentes :
ADMIN_TOKEN="my_admin_static_token"
DEV_TOKEN="my_dev_static_token"
GUEST_TOKEN="my_guest_static_token"
