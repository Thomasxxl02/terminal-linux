{
  "name": "terminal-linux",
  "private": true,
  "version": "0.1.0",
  "description": "Émulateur de terminal Linux haute performance : xterm.js + PTY Rust (Tauri) avec mode web optionnel (Express/WebSocket).",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Thomas CARPENTIER",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:tauri": "vite",
    "build": "npm run copy:monaco && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "predev": "npm run copy:monaco",
    "predev:tauri": "npm run copy:monaco",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-prod.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "npm run lint && npm run test && npm run check:rust && npm audit --omit=dev",
    "check:rust": "cd src-tauri && cargo check && cargo audit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "lucide-react": "^1.30.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.11",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
